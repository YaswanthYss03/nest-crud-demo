generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  genre       String
  director    String
  language    String
  releaseYear Int
  rating      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}